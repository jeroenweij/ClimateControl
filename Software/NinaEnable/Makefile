# Convenience wrapper around this directory's standalone CMake project (see
# CMakeLists.txt) -- deliberately separate from Software/Makefile, this
# utility never participates in the normal firmware build.
#
#   make build     configure (if needed) and compile ninaEnable.elf/.bin/.hex
#   make program   build, then flash it to the board over SWD via J-Link
#   make clean     remove build/
#
# Overridable: BUILD_DIR, JOBS, CMAKE

BUILD_DIR ?= build
JOBS      ?= $(shell nproc)
CMAKE     ?= cmake

CACHE := $(BUILD_DIR)/CMakeCache.txt

.PHONY: help build program clean
.DEFAULT_GOAL := help

help:
	@awk '/^#/{sub(/^# ?/, ""); print; next} {exit}' $(firstword $(MAKEFILE_LIST))

$(CACHE):
	$(CMAKE) -S . -B $(BUILD_DIR)

build: $(CACHE)
	$(CMAKE) --build $(BUILD_DIR) -j $(JOBS)

# Builds, then drives JLinkExe (via the flash-ninaEnable target generated by
# add_stm32_executable) to load the image over SWD and reset the board.
program: build
	$(CMAKE) --build $(BUILD_DIR) --target flash-ninaEnable

clean:
	rm -rf $(BUILD_DIR)
